{
  "manifest_version": 3,
  "name": "collager.fm - Last.fm companion",
  "version": "0.11.1",
  "description": "Permite ao collager.fm substituir ou excluir scrobbles e gerenciar obsessoes usando a sessao web do Last.fm.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.last.fm/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "collager.fm",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "history.html",
        "history.css",
        "history.js",
        "icons/icon.svg"
      ],
      "matches": [
        "https://collagerfm.vercel.app/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://collagerfm.vercel.app/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.last.fm/*"],
      "js": ["lastfm-content.js"],
      "run_at": "document_idle"
    }
  ]
}
